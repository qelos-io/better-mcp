{
  "name": "@qelos/better-mcp",
  "version": "0.3.3",
  "description": "MCP gateway/proxy: fan out to many MCP servers (stdio or HTTP with OAuth login) behind one endpoint, with a middleware pipeline, a built-in management app and a community marketplace.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "better-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/marketplace/servers.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:build": "npm run build && npm test",
    "prepublishOnly": "npm run build && npm test",
    "marketplace:build": "tsx src/marketplace/build.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "claude",
    "cursor",
    "gateway",
    "http",
    "marketplace",
    "mcp",
    "middleware",
    "model-context-protocol",
    "oauth",
    "proxy",
    "stdio",
    "streamable-http",
    "token-reduction"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qelos-io/better-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/qelos-io/better-mcp/issues"
  },
  "homepage": "https://github.com/qelos-io/better-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=18"
  }
}
